# Copy these into your host's environment variables (Render/Railway/Replit Secrets).
RUNNER_NAME=Michael
# Paste your Garmin LiveTrack link on race morning (or leave blank until then)
LIVETRACK_URL=
# Goal time for the projected-finish line on the page (h:mm:ss)
GOAL_TIME=3:00:00
# Segment size in miles for the results table (Miles 1-4, 5-8, ...)
SEGMENT_MILES=4
# Sample stats so the page can be checked without a run. Local testing only (ignored on Render).
# DEMO_STATS=1
# Optional but recommended: anyone without ?key=... in the link can't open the page or send
ACCESS_KEY=pick-a-long-random-string

# Delivery (email -> Verizon MMS gateway). Leave blank to test without sending.
DEST_ADDRESS=10digitnumber@vzwpix.com
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password
# What Siri says before the clip. {name} becomes the sender's name.
MESSAGE_TEMPLATE=From {name}
# Minimum seconds between notes from the same person (0 = off, 1800 = 30 min)
COOLDOWN_SECONDS=0
# Spoken "From <name>" glued onto the front of each clip (set SPOKEN_INTRO=0 to turn off)
SPOKEN_INTRO=1
INTRO_TEMPLATE=From {name}
# Text Siri reads before the clip when the intro is spoken (blank = "Lock in";
# a blank message made Siri say "a message I can't read")
TEXT_WHEN_SPOKEN=Lock in
